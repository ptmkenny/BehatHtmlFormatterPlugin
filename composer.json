{
    "name": "floviolleau/behat-html-formatter",
    "description": "This will create a html formatter for Behat.",
    "license": "MIT",
    "authors": [
        {
            "name": "Neal Vanmeert",
            "email": "neal@emuse.be"
        }
    ],
    "require": {
        "php": ">=8.2",
        "twig/twig": "^3.0",
        "behat/behat": "^4.0",
        "behat/gherkin": "^4.18"
    },
    "require-dev": {
        "friends-of-behat/mink-extension": "^3.0@alpha",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "friends-of-behat/mink-extension": "Required by ScreenshotContext (^3.0 for Behat 4)"
    },
    "autoload": {
        "psr-4": {
            "emuse\\BehatHTMLFormatter\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        }
    }
}
